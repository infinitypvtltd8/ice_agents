entrypoint = "ICE_Local/app.py"
run = "python ICE_Local/app.py --host 0.0.0.0 --port 5000 --no-browser"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
build = ["sh", "-c", "python -m pip install -r requirements.txt"]
run = ["sh", "-c", "python ICE_Local/app.py --host 0.0.0.0 --port 5000 --no-browser"]
